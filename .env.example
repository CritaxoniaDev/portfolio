# ──────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in what you need:
#
#   cp .env.example .env.local
#
# Every value here is optional. With none of them set the site still
# builds and runs — Sentry initialises to a no-op and asset stamping
# stays off. Nothing below is required for local development.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time, so changing one needs a rebuild, not just a server restart.
#
# .env.local is gitignored; this file is committed. Never put a real
# secret in it.
# ──────────────────────────────────────────────────────────────────────


# ── Sentry — error monitoring ─────────────────────────────────────────

# Turns reporting on. Public by design: a DSN only permits *sending*
# events, it can't read anything out of your Sentry project.
# Leave blank to keep the SDK inert.
# Format: https://<key>@o<org-id>.ingest.<region>.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only — where source maps get uploaded. Find them in
# Sentry under Settings → Projects (the slugs in the URL).
SENTRY_ORG=
SENTRY_PROJECT=

# Secret. Belongs in CI / Vercel project env vars, not in a file you
# might commit. Without it the build logs that it skipped the source
# map upload and carries on, but stack traces stay minified.
# Create at: Sentry → Settings → Auth Tokens (scope: project:releases)
SENTRY_AUTH_TOKEN=


# ── Deployment identity ───────────────────────────────────────────────

# Stamps static assets as ?dpl=<id> so a browser left open across a
# deploy keeps loading chunks from the build it was served, and tags
# Sentry releases so they line up with the uploaded source maps.
#
# On Vercel leave this blank — VERCEL_DEPLOYMENT_ID is picked up
# automatically. Set it anywhere else (e.g. the git SHA in CI).
#
# NEXT_PUBLIC_DEPLOYMENT_ID is derived from this in next.config.ts for
# the browser bundle. Don't set it yourself; the two must not diverge.
NEXT_DEPLOYMENT_ID=
